{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=gnu++23",
        "-O2",
        "-g",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "g++でコンパイル"
    },
    {
      "label": "C++: Build (Release)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=gnu++23",
        "-O3",
        "-DNDEBUG",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}_release.exe"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "g++でリリースビルド（最適化最大、デバッグ情報なし）"
    },
    {
      "label": "C++: Build & Run",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=gnu++23",
        "-O2",
        "-g",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "g++でコンパイル後、実行",
      "dependsOn": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "C++: Run",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "group": "test",
      "problemMatcher": [],
      "detail": "コンパイル済みの実行ファイルを実行",
      "dependsOn": "C++: Build & Run",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "C++: Build & Run (Release)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=gnu++23",
        "-O3",
        "-DNDEBUG",
        "-Wall",
        "-Wextra",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}_release.exe"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "g++でリリースビルド後、実行"
    },
    {
      "label": "C++: Run (Release)",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}_release.exe",
      "group": "test",
      "problemMatcher": [],
      "detail": "リリースビルド済みの実行ファイルを実行",
      "dependsOn": "C++: Build & Run (Release)",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ]
}
